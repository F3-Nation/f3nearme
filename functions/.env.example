# F3 Nation API Configuration
# Copy this file to .env and fill in your actual values
# The .env file is gitignored and will not be committed

F3_API_KEY=your_api_key_here
F3_CLIENT=f3nearme-local
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Web push (trip reminders): generate with `npx web-push generate-vapid-keys`
# The public key must match vapidPublicKey in src/environments/*.ts
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:you@example.com
