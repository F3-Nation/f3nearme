{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulator": "npm run build && firebase emulators:start --import=../emulator-data --export-on-exit=../emulator-data",
    "emulator:debug": "npm run build && firebase emulators:start --import=../emulator-data --export-on-exit=../emulator-data --inspect-functions",
    "emulator:fresh": "npm run build && firebase emulators:start --export-on-exit=../emulator-data",
    "export-prod-data": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node ../scripts/export-prod-data.js"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.7.0",
    "@google-cloud/storage": "^7.7.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/express": "^4.17.21"
  },
  "private": true
}