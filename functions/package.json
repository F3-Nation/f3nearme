{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "emulator": "npm run build && firebase emulators:start --import=../emulator-data --export-on-exit=../emulator-data",
    "emulator:debug": "npm run build && firebase emulators:start --import=../emulator-data --export-on-exit=../emulator-data --inspect-functions",
    "emulator:empty": "npm run build && firebase emulators:start --export-on-exit=../emulator-data",
    "export-prod-data": "GOOGLE_APPLICATION_CREDENTIALS=./service-account.json node ../scripts/export-prod-data.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.7.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.3.3"
  },
  "private": true
}
