rules_version = '2';
// PHASE 2 RULES — DO NOT DEPLOY BEFORE ~2026-09-15.
//
// The app now serves all workout data from the CDN JSON cache
// (https://storage.googleapis.com/f3-workout.appspot.com/data/all.json).
// Direct Firestore reads are only used by stale PWA bundles from before
// 2026-09-08. Once those have rolled over (~1 week), replace firestore.rules
// with this file and run:  firebase deploy --only firestore:rules
//
// This shuts off the external scraper that has been dumping the public
// beatdowns collection ~once per minute since 2026-09-01 (~13M reads/day).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
